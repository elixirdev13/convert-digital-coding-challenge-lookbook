{%- comment -%}
  Renders the mount point for the React lookbook app and embeds the data it needs.

  Accepts:
    handles                 - comma-separated list of lookbook metaobject handles
    columns                 - number of columns (2-4)
    show_description        - boolean, whether to render lookbook descriptions
    image_ratio             - product image aspect ratio (portrait|square|landscape)
    heading_font_size       - font size (px) for the lookbook title
    subheading_font_size    - font size (px) for the lookbook description
    product_title_font_size - font size (px) for each product tile title
    price_font_size         - font size (px) for each product price
    storefront_access_token - public Storefront API token (entered in theme editor)
    uid                     - unique id for this instance (usually section.id)

  The metaobject stores products as a *product reference list* (merchant-friendly
  picker in the admin). We resolve those references down to product *handles*
  here, so the React app still receives handles only. Product data (price,
  compare-at, image) is fetched client-side by the React app via the Storefront
  API so that market-based price overrides resolve correctly at runtime.
{%- endcomment -%}

{%- assign handle_list = handles | split: ',' -%}

{%- capture lookbooks_json -%}
  {%- assign sep = '' -%}
  [
  {%- for raw_handle in handle_list -%}
    {%- assign lb_handle = raw_handle | strip -%}
    {%- assign lookbook = shop.metaobjects['lookbook'][lb_handle] -%}
    {%- if lookbook != blank -%}
      {%- capture product_handles_json -%}
        {%- assign p_sep = '' -%}
        [
        {%- for lb_product in lookbook.products.value -%}
          {%- if lb_product != blank -%}
            {{ p_sep }}{{ lb_product.handle | json }}
            {%- assign p_sep = ',' -%}
          {%- endif -%}
        {%- endfor -%}
        ]
      {%- endcapture -%}
      {{ sep }}{
        "handle": {{ lb_handle | json }},
        "title": {{ lookbook.title.value | json }},
        "description": {{ lookbook.description.value | json }},
        "productHandles": {{ product_handles_json }}
      }
      {%- assign sep = ',' -%}
    {%- endif -%}
  {%- endfor -%}
  ]
{%- endcapture -%}

<div
  id="lookbook-app-{{ uid }}"
  data-lookbook-app
>
  <script type="application/json" data-lookbook-payload>
    {
      "lookbooks": {{ lookbooks_json }},
      "settings": {
        "columns": {{ columns | default: 3 }},
        "showDescription": {{ show_description | default: false }},
        "imageRatio": {{ image_ratio | default: 'portrait' | json }},
        "headingFontSize": {{ heading_font_size | default: 28 }},
        "subheadingFontSize": {{ subheading_font_size | default: 16 }},
        "productTitleFontSize": {{ product_title_font_size | default: 14 }},
        "priceFontSize": {{ price_font_size | default: 14 }}
      },
      "config": {
        "shopDomain": {{ shop.permanent_domain | json }},
        "storefrontToken": {{ storefront_access_token | json }},
        "apiVersion": "2026-07",
        "country": {{ localization.country.iso_code | json }},
        "language": {{ localization.language.iso_code | json }}
      }
    }
  </script>
</div>

{{ 'lookbook.bundle.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lookbook.bundle.js' | asset_url }}" defer></script>
