{%- comment -%}
  Homepage lookbook section.

  The merchant picks exactly one lookbook to display using the native metaobject
  picker (Lookbook setting). All display/styling options (columns, description,
  image ratio, typography, and the Storefront API token) are shared across the
  homepage and product-page lookbooks and live in Theme settings → Lookbook, so
  configuring them once affects both places.
{%- endcomment -%}

{%- if section.settings.lookbook_entry != blank -%}
  {%- render 'lookbook-mount',
    handles: section.settings.lookbook_entry.system.handle,
    columns: settings.lookbook_columns,
    show_description: settings.lookbook_show_description,
    image_ratio: settings.lookbook_image_ratio,
    enable_carousel: settings.lookbook_enable_carousel,
    text_color: settings.lookbook_text_color,
    background_color: settings.lookbook_background_color,
    heading_font_size: settings.lookbook_heading_font_size,
    subheading_font_size: settings.lookbook_subheading_font_size,
    product_title_font_size: settings.lookbook_product_title_font_size,
    price_font_size: settings.lookbook_price_font_size,
    storefront_access_token: settings.lookbook_storefront_token,
    uid: section.id
  -%}
{%- elsif request.design_mode -%}
  <p style="text-align:center;padding:2rem;">
    Select a lookbook in this section's settings to display it here.
  </p>
{%- endif -%}

{% schema %}
{
  "name": "Lookbook",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "metaobject",
      "id": "lookbook_entry",
      "label": "Lookbook",
      "metaobject_type": "lookbook",
      "info": "Pick the lookbook to display here. Styling (columns, typography, image ratio, Storefront token) is shared in Theme settings → Lookbook."
    }
  ],
  "presets": [
    {
      "name": "Lookbook"
    }
  ],
  "enabled_on": {
    "templates": ["index", "page"]
  }
}
{% endschema %}
