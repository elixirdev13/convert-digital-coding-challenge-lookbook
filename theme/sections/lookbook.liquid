{%- comment -%}
  Homepage lookbook section.

  The merchant picks exactly one lookbook to display using the native metaobject
  picker (Lookbook setting). The section can be added to the home page (and any
  other template) via the theme customizer.
{%- endcomment -%}

{%- if section.settings.lookbook_entry != blank -%}
  {%- render 'lookbook-mount',
    handles: section.settings.lookbook_entry.system.handle,
    columns: section.settings.columns,
    show_description: section.settings.show_description,
    image_ratio: section.settings.image_ratio,
    heading_font_size: section.settings.heading_font_size,
    subheading_font_size: section.settings.subheading_font_size,
    product_title_font_size: section.settings.product_title_font_size,
    price_font_size: section.settings.price_font_size,
    storefront_access_token: section.settings.storefront_access_token,
    uid: section.id
  -%}
{%- elsif request.design_mode -%}
  <p style="text-align:center;padding:2rem;">
    Select a lookbook in this section's settings to display it here.
  </p>
{%- endif -%}

{% schema %}
{
  "name": "Lookbook",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "metaobject",
      "id": "lookbook_entry",
      "label": "Lookbook",
      "metaobject_type": "lookbook",
      "info": "Pick the lookbook to display on this section."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show lookbook description",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ],
      "default": "portrait"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "Subheading font size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "product_title_font_size",
      "label": "Product title font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "price_font_size",
      "label": "Price font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Storefront API"
    },
    {
      "type": "text",
      "id": "storefront_access_token",
      "label": "Storefront API public token",
      "info": "Public token used to fetch product data at runtime. Safe to expose on the storefront."
    }
  ],
  "presets": [
    {
      "name": "Lookbook"
    }
  ],
  "enabled_on": {
    "templates": ["index", "page"]
  }
}
{% endschema %}
