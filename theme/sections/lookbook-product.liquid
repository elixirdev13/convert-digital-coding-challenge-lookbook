{%- comment -%}
  Product page lookbook section.

  This section does NOT let the merchant pick a lookbook. Instead it renders any
  lookbook that contains the current product. If the product appears in three or
  more lookbooks, only the first two are shown (per requirements).

  All display/styling options are shared with the homepage lookbook and live in
  Theme settings → Lookbook.
{%- endcomment -%}

{%- assign matched_handles = '' -%}
{%- assign matched_count = 0 -%}

{%- for lookbook in shop.metaobjects['lookbook'].values -%}
  {%- if matched_count >= 2 -%}
    {%- break -%}
  {%- endif -%}
  {%- assign is_member = false -%}
  {%- for lb_product in lookbook.products.value -%}
    {%- if lb_product.handle == product.handle -%}
      {%- assign is_member = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if is_member -%}
    {%- if matched_handles == '' -%}
      {%- assign matched_handles = lookbook.system.handle -%}
    {%- else -%}
      {%- assign matched_handles = matched_handles | append: ',' | append: lookbook.system.handle -%}
    {%- endif -%}
    {%- assign matched_count = matched_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

{%- if matched_handles != '' -%}
  {%- render 'lookbook-mount',
    handles: matched_handles,
    columns: settings.lookbook_columns,
    show_description: settings.lookbook_show_description,
    image_ratio: settings.lookbook_image_ratio,
    heading_font_size: settings.lookbook_heading_font_size,
    subheading_font_size: settings.lookbook_subheading_font_size,
    product_title_font_size: settings.lookbook_product_title_font_size,
    price_font_size: settings.lookbook_price_font_size,
    storefront_access_token: settings.lookbook_storefront_token,
    uid: section.id
  -%}
{%- elsif request.design_mode -%}
  <p style="text-align:center;padding:2rem;">
    This product is not part of any lookbook yet. Add it to a lookbook
    metaobject's Products field to see it here.
  </p>
{%- endif -%}

{% schema %}
{
  "name": "Lookbook (product)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Automatically shows any lookbook the current product belongs to (max 2). Styling is shared in Theme settings → Lookbook."
    }
  ],
  "presets": [
    {
      "name": "Lookbook (product)"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
