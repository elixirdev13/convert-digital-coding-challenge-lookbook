{%- comment -%}
  Product page lookbook section.

  This section does NOT let the merchant pick a lookbook. Instead it renders any
  lookbook that contains the current product. If the product appears in three or
  more lookbooks, only the first two are shown (per requirements).

  All other customization settings are identical to the homepage Lookbook section.
{%- endcomment -%}

{%- assign matched_handles = '' -%}
{%- assign matched_count = 0 -%}

{%- for lookbook in shop.metaobjects['lookbook'].values -%}
  {%- if matched_count >= 2 -%}
    {%- break -%}
  {%- endif -%}
  {%- assign is_member = false -%}
  {%- for lb_product in lookbook.products.value -%}
    {%- if lb_product.handle == product.handle -%}
      {%- assign is_member = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if is_member -%}
    {%- if matched_handles == '' -%}
      {%- assign matched_handles = lookbook.system.handle -%}
    {%- else -%}
      {%- assign matched_handles = matched_handles | append: ',' | append: lookbook.system.handle -%}
    {%- endif -%}
    {%- assign matched_count = matched_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

{%- if matched_handles != '' -%}
  {%- render 'lookbook-mount',
    handles: matched_handles,
    heading: section.settings.heading,
    columns: section.settings.columns,
    show_description: section.settings.show_description,
    heading_font_size: section.settings.heading_font_size,
    subheading_font_size: section.settings.subheading_font_size,
    product_title_font_size: section.settings.product_title_font_size,
    price_font_size: section.settings.price_font_size,
    storefront_access_token: section.settings.storefront_access_token,
    uid: section.id
  -%}
{%- elsif request.design_mode -%}
  <p style="text-align:center;padding:2rem;">
    This product is not part of any lookbook yet. Add it to a lookbook
    metaobject's Products field to see it here.
  </p>
{%- endif -%}

{% schema %}
{
  "name": "Lookbook (product)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Automatically shows any lookbook the current product belongs to (max 2)."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the look"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show lookbook description",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "Subheading font size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "product_title_font_size",
      "label": "Product title font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "price_font_size",
      "label": "Price font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Storefront API"
    },
    {
      "type": "text",
      "id": "storefront_access_token",
      "label": "Storefront API public token",
      "info": "Public token used to fetch product data at runtime. Safe to expose on the storefront."
    }
  ],
  "presets": [
    {
      "name": "Lookbook (product)"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
