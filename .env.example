# Reference values for local theme development.
#
# The public Storefront API access token is safe to expose on the storefront
# (that is its purpose). In this theme it is hardcoded in
# theme/snippets/lookbook-mount.liquid (so a merchant can't accidentally clear
# it), NOT read from this file at runtime. These values are here only to document
# what you need and for any local tooling/scripts you may add.

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2026-07
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
