# Reference values for local theme development.
#
# The public Storefront API access token is safe to expose on the storefront
# (that is its purpose). In this theme it is entered by the merchant in the
# theme customizer setting `storefront_access_token` on the lookbook sections,
# NOT read from this file at runtime. These values are here only to document
# what you need and for any local tooling/scripts you may add.

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2025-07
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
